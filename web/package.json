{
  "name": "acoustic-sandbox",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Browser-native acoustic FDTD sandbox (client-side engine, GitHub Pages).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "render": "vite build --ssr scripts/render.ts --outDir .render --emptyOutDir --logLevel warn && node .render/render.js",
    "loop:data": "vite build --ssr scripts/loop_sensing_data.ts --outDir .render/loop-data --emptyOutDir --logLevel warn && node .render/loop-data/loop_sensing_data.js",
    "loop:eval": "vite build --ssr scripts/loop_sensing_eval.ts --outDir .render/loop-eval --emptyOutDir --logLevel warn && node .render/loop-eval/loop_sensing_eval.js"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
